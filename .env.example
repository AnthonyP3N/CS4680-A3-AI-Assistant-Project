# Copy this file to .env and fill in ONE API key.
# With no key, FocusFlow runs in "demo mode": offline rules instead of an AI model.

# Which provider to use: gemini | openai | anthropic | demo
# Leave blank to use the first provider that has a key.
AI_PROVIDER=

# Google Gemini (has a free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional
PORT=3000
AI_HOURLY_LIMIT=60
AI_TIMEOUT_MS=45000
